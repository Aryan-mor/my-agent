{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  // Moderately more aggressive than defaults to cut tokens/min on rate-limited providers (e.g. a RadoxAI Starter TPM limit).
  "pruneNotification": "minimal",
  "compress": {
    // models kept misusing the compress tool (fake/looping calls); disable it, keep automatic pruning
    "permission": "deny",
    // default 100000: start strong compression nudges earlier
    "maxContextLimit": 80000,
    // default 50000: turn/iteration reminders kick in sooner
    "minContextLimit": 35000,
    // default 5: nudge every 3rd request when above maxContextLimit
    "nudgeFrequency": 3,
    // default 15: remind after 10 agent iterations without a user message
    "iterationNudgeThreshold": 10,
    // default "soft"
    "nudgeForce": "strong"
  },
  "strategies": {
    "deduplication": { "enabled": true },
    // default 4: drop inputs of failed tool calls after 2 turns
    "purgeErrors": { "enabled": true, "turns": 2 }
  }
}
