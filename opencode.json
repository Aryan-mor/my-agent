{
  "$schema": "https://opencode.ai/config.json",
  "model": "auto/sonnet",
  "provider": {
    "auto": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Auto (LiteLLM failover)",
      "options": {
        "baseURL": "http://127.0.0.1:{env:LITELLM_PORT}/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}"
      },
      "models": {
        "sonnet": {
          "name": "Free chain (Kilo -> OpenRouter -> Gemini -> NVIDIA -> GLM -> local)",
          "tool_call": true,
          "limit": {
            "context": 80000,
            "output": 16000
          }
        },
        "opus": {
          "name": "Free chain, strong first (Nemotron -> GLM -> Gemini -> Kilo -> local)",
          "tool_call": true,
          "limit": {
            "context": 80000,
            "output": 16000
          }
        },
        "ollama-local": {
          "name": "Local Ollama model (MYAGENT_LOCAL_MODEL, only when MYAGENT_LOCAL=on)",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "kilo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kilo (free)",
      "options": {
        "baseURL": "https://api.kilo.ai/api/gateway",
        "apiKey": "{env:KILO_API_KEY}"
      },
      "models": {
        "kilo-auto/free": {
          "name": "Kilo Auto Free",
          "tool_call": true
        }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter (free)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b:free": {
          "name": "Nemotron 3 Ultra 550B (free)",
          "tool_call": true
        },
        "openrouter/free": {
          "name": "OpenRouter Auto Free",
          "tool_call": true
        }
      }
    },
    "glm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GLM Free",
      "options": {
        "baseURL": "http://localhost:3001/v1",
        "apiKey": "{env:GLM_API_KEY}"
      },
      "models": {
        "glm-5.3": {
          "name": "GLM 5.3"
        },
        "glm-5.2": {
          "name": "GLM 5.2"
        }
      }
    },
    "glma": {
      "npm": "@ai-sdk/anthropic",
      "name": "GLM Free (Anthropic API)",
      "options": {
        "baseURL": "http://localhost:3001/v1",
        "apiKey": "{env:GLM_API_KEY}"
      },
      "models": {
        "glm-5.3": {
          "name": "GLM 5.3 (Anthropic)"
        }
      }
    },
    "gemini": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Gemini",
      "options": {
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash",
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "git push *": "ask",
      "git push": "ask",
      "git reset --hard *": "ask",
      "git clean *": "ask",
      "git checkout -- *": "ask",
      "npm publish *": "ask",
      "pnpm publish *": "ask",
      "flutter pub publish *": "ask",
      "rm -rf *": "ask",
      "Remove-Item * -Recurse*": "ask",
      "Format-Volume *": "ask"
    },
    "external_directory": "allow",
    "doom_loop": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "small_model": "opencode/deepseek-v4.1-flash-free",
  "agent": {
    "explore": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "build": {
      "model": "auto/sonnet"
    },
    "plan": {
      "model": "auto/opus"
    },
    "general": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "deep": {
      "description": "Use for hard architecture/debugging problems only",
      "mode": "subagent",
      "model": "auto/opus"
    }
  },
  "instructions": [],
  "plugin": [
    "@tarquinen/opencode-dcp@latest"
  ]
}
