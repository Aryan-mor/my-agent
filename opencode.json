{
  "$schema": "https://opencode.ai/config.json",
  "model": "auto/sonnet",
  "provider": {
    "auto": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Auto (LiteLLM failover)",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}"
      },
      "models": {
        "sonnet": {
          "name": "Sonnet (radox -> gemini/gpt/kimi/glm)",
          "tool_call": true,
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "opus": {
          "name": "Opus (radox -> sonnet -> gemini/gpt/kimi/glm)",
          "tool_call": true,
          "limit": {
            "context": 200000,
            "output": 32000
          }
        }
      }
    },
    "glm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GLM Free",
      "options": {
        "baseURL": "http://localhost:3001/v1",
        "apiKey": "{env:GLM_API_KEY}"
      },
      "models": {
        "glm-5.3": {
          "name": "GLM 5.3"
        },
        "glm-5.2": {
          "name": "GLM 5.2"
        }
      }
    },
    "glma": {
      "npm": "@ai-sdk/anthropic",
      "name": "GLM Free (Anthropic API)",
      "options": {
        "baseURL": "http://localhost:3001/v1",
        "apiKey": "{env:GLM_API_KEY}"
      },
      "models": {
        "glm-5.3": {
          "name": "GLM 5.3 (Anthropic)"
        }
      }
    },
    "radox": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "RadoxAI",
      "options": {
        "baseURL": "https://radoxai.com/v1",
        "apiKey": "{env:RADOX_API_KEY}"
      },
      "models": {
        "claude-opus-5.5": {
          "name": "Claude Opus 5.5 (Radox)"
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5"
        }
      }
    },
    "gemini": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Gemini",
      "options": {
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash",
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "git push *": "ask",
      "git push": "ask",
      "git reset --hard *": "ask",
      "git clean *": "ask",
      "git checkout -- *": "ask",
      "npm publish *": "ask",
      "pnpm publish *": "ask",
      "flutter pub publish *": "ask",
      "rm -rf *": "ask",
      "Remove-Item * -Recurse*": "ask",
      "Format-Volume *": "ask"
    },
    "external_directory": "allow",
    "doom_loop": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "small_model": "opencode/deepseek-v4.1-flash-free",
  "agent": {
    "explore": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "build": {
      "model": "auto/sonnet"
    },
    "plan": {
      "model": "auto/opus"
    },
    "general": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "deep": {
      "description": "Use for hard architecture/debugging problems only",
      "mode": "subagent",
      "model": "auto/opus"
    }
  },
  "instructions": [],
  "plugin": [
    "@tarquinen/opencode-dcp@latest"
  ]
}