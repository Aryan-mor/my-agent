# my-agent environment. Copy to .env (same folder) and fill in. Never commit .env (it is in .gitignore).
# agent.ps1, start-litellm.ps1, my-agent-local.ps1, test_proxy.py, chat.py and list_models.py all read this file.
# A setup agent (Claude Code / Grok Bot) fills this in by following SETUP.md.

# --- Sign-up credentials for the setup agent (optional) ----------------------------
# Email + password the setup agent uses to create free accounts on the provider sites below
# (Kilo, OpenRouter, NVIDIA NIM, Google AI Studio) and fetch their API keys. Leave empty if you
# prefer to sign up yourself or with "Continue with Google". Use a password you use nowhere else.
# You may clear these again once all keys are filled in.
SIGNUP_EMAIL=
SIGNUP_PASSWORD=

# --- LiteLLM proxy (required) -------------------------------------------------
# REQUIRED. Password for your local LiteLLM proxy; OpenCode sends it to 127.0.0.1:4000. Make up any long random string, e.g. sk- followed by 32 random characters.
LITELLM_MASTER_KEY=
# OPTIONAL. Port of the proxy (default 4000). If you change it, change baseURL of the "auto" provider in opencode.json too.
LITELLM_PORT=

# --- Model providers (free tiers; the more you fill, the more fallbacks) ---------
# RECOMMENDED (primary "sonnet"). Kilo gateway key: https://app.kilo.ai -> sign up -> profile/API keys -> copy key.
KILO_API_KEY=
# RECOMMENDED (primary "opus" + free fallbacks). OpenRouter key (starts with sk-or-): https://openrouter.ai/settings/keys -> Create Key.
OPENROUTER_API_KEY=
# OPTIONAL (nvidia-nemotron / nvidia-glm fallbacks). NVIDIA NIM key (starts with nvapi-): https://build.nvidia.com/settings/api-keys -> Generate API Key.
NVIDIA_API_KEY=
# OPTIONAL. Google Gemini key for the gemini-flash fallback and the "gemini" OpenCode provider (https://aistudio.google.com/app/apikey -> Create API key); chat.py/list_models.py also use it with OPENAI_BASE_URL.
OPENAI_API_KEY=
# OPTIONAL. OpenAI-compatible base URL for scripts/chat.py and scripts/list_models.py only (default https://api.llm7.io/v1); e.g. https://generativelanguage.googleapis.com/v1beta/openai for Gemini.
OPENAI_BASE_URL=
# OPTIONAL. Default model for scripts/chat.py (default codestral-latest); must exist on OPENAI_BASE_URL.
OPENAI_MODEL=
# OPTIONAL. Token for a local OpenAI-compatible GLM bridge on 127.0.0.1:3001. Leave empty if you have none; read automatically from GLM_BRIDGE_DIR\.env (AUTH_TOKEN=) when that is set.
GLM_API_KEY=

# --- Local model (Ollama) ------------------------------------------------------
# on = add your local Ollama model as the LAST fallback of the chain (and as auto/ollama-local in OpenCode).
# off = no local model (default; needs no GPU). Toggle later with: scripts\my-agent-local.ps1 on|off|status
MYAGENT_LOCAL=off
# Ollama model tag to use (must be pulled: ollama pull <tag>). Smaller GPUs: qwen2.5-coder:7b, qwen3-coder:30b needs ~20 GB VRAM/RAM.
MYAGENT_LOCAL_MODEL=qwen3-coder:30b
# OpenAI-compatible endpoint of Ollama.
MYAGENT_LOCAL_URL=http://127.0.0.1:11434/v1

# --- Paths and switches (all optional) -----------------------------------------
# OPTIONAL, read from the Windows environment by delegate.ps1 (not from this file). auto (default) | opencode | agy. auto uses Antigravity CLI (agy) for hard/medium plans when installed and its quota allows, else the free chain.
MYAGENT_ENGINE=
# OPTIONAL. Folder of a local GLM bridge that has a start.bat (and optionally a .env with AUTH_TOKEN=); agent.ps1 starts it. Empty = no GLM bridge.
GLM_BRIDGE_DIR=
# OPTIONAL. Folder containing start-litellm.ps1 + config.yaml + .venv, if not this repo's litellm\ folder.
LITELLM_DIR=
# OPTIONAL. Full path to an existing litellm.exe to use instead of litellm\.venv\Scripts\litellm.exe.
LITELLM_EXE=
# OPTIONAL. Set to 1 to switch off the optional rtk OpenCode plugin for the whole session.
RTK_DISABLED=
# MY_AGENT_HOME (OPTIONAL) is NOT read from this file: set it as a Windows user environment variable only if the scripts live outside this repo; by default they find the repo from their own location.
